# Copy to .env for local development. In Coolify, set these as the
# application's environment variables instead — never commit real values.

DATABASE_URL=postgresql://user:password@host:5432/dbname

SASUSYNC_API_KEY=sk_live_xxx
SASUSYNC_WEBHOOK_SECRET=xxx
SASUSYNC_SENDER_ID=COSSA

TELEGRAM_BOT_TOKEN=123456:xxx
# Bot API chat ids for supergroups are usually -100 followed by the number
# shown in the web client's URL. If sendMessage returns "chat not found",
# try prefixing with -100.
TELEGRAM_CHAT_ID=-1000000000000

DUES_AMOUNT_CONTINUING=50
DUES_AMOUNT_FRESHER=100

# Must be the exact public HTTPS origin this app is deployed at, no
# trailing slash. Used to build the redirect_url sent to SasuSync, and the
# short receipt link texted to students. The webhook URL registered in the
# SasuSync admin must be exactly this origin + /webhooks/sasusync/payment.
APP_BASE_URL=https://cossa.sasusync.com

PORT=8000
